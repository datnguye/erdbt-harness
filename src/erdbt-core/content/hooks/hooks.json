{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/ir-lint.sh\"",
            "timeout": 10,
            "statusMessage": "Linting IR..."
          }
        ]
      }
    ]
  }
}
